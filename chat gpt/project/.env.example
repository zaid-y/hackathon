# Local folders
DOCUMENTS_DIR=data/documents
INDEX_DIR=data/index

# Retrieval settings (used from Phase 2/3 onward)
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
RELEVANCE_THRESHOLD=0.35
DEBUG=false

# ThaiLLM Typhoon endpoint. Paste your own key locally; never commit .env.
THAILLM_API_KEY=
THAILLM_BASE_URL=https://thaillm.or.th/api/typhoon/v1
THAILLM_MODEL=/model
THAILLM_TIMEOUT_SECONDS=60
